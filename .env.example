# Supabase — Visionary Ventures project (for the Book a Consultation form).
# Get these from the VV Supabase project: Settings → API.
# Both are safe to expose in the browser (publishable/anon key only).
# Copy this file to .env.local for local dev, and add the same vars in Vercel → Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
